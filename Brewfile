# Brewfile - what only the Mac mini needs, on top of dotfiles' Brewfile and
# Brewfile.apps. Usage: brew bundle --file Brewfile

# Remote desktop: the host side. Clients use Jump Desktop, from dotfiles.
cask "jump-desktop-connect"

# Monitoring (docs/MONITORING.md). The panel expects Python in /opt/homebrew.
brew "netdata"
brew "macmon"
brew "smartmontools"
brew "btop"           # live view in a terminal over SSH
brew "python"
